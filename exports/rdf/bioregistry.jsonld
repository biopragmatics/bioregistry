    {
      "@id": "https://bioregistry.io/registry/knetminer",
      "@type": "https://bioregistry.io/schema/#0000001",
      "http://purl.org/dc/terms/description": "KnetMiner is a knowledge graph platform for evidence-based gene discovery and complex trait analysis across plants, crops and other species. It integrates genome annotations, orthology, pathways, protein interactions, gene expression, phenotypes, GWAS results and the published literature into a single knowledge graph, and publishes a gene page for every gene it holds. Identifiers in this namespace resolve to the KnetMiner gene page for a given gene in a given species, showing that gene's network context, traits, functional annotations, orthologs and supporting literature evidence.",
      "http://purl.org/dc/terms/isPartOf": {
        "@id": "https://bioregistry.io/metaregistry/bioregistry"
      },
      "http://www.w3.org/2000/01/rdf-schema#label": {
        "@value": "KnetMiner"
      },
