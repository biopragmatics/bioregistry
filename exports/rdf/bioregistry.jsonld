        },
        {
          "@value": "ontology"
        },
        {
          "@value": "mechanical engineering, energy technology"
        },
        {
          "@value": "chemical and environmental engineering"
        }
      ],
      "http://xmlns.com/foaf/0.1/homepage": {
        "@id": "https://materialdigital.github.io/core-ontology/"
      },
