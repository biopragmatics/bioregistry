      "https://bioregistry.io/schema/#0000012": false,
      "https://bioregistry.io/schema/#0000019": {
        "@id": "https://orcid.org/0000-0002-6388-446X"
      },
      "https://bioregistry.io/schema/#0000023": {
        "@value": "civic.assertion"
      },
      "https://bioregistry.io/schema/#0000024": "https://civicdb.org/links/assertions/",
      "https://bioregistry.io/schema/#0000026": {
        "@id": "https://ror.org/01yc7t268"
      },
      "https://bioregistry.io/schema/#0000027": {
        "@id": "https://civicdb.org/links/assertions/3"
