    {
      "@id": "https://bioregistry.io/registry/gesis.rexconcepts",
      "@type": "https://bioregistry.io/schema/#0000001",
      "http://purl.org/dc/terms/contributor": {
        "@id": "https://orcid.org/0000-0003-4423-4370"
      },
      "http://purl.org/dc/terms/description": "This CV, developed within the framework of the DP-R|EX joint project, involving the partner institutions DeZIM, Qualiservice and GESIS, maps the central concepts and theoretical approaches in research on racism and right-wing extremism. The compilation is based on a systematic evaluation of the relevant national and international empirical research literature. The CV equally takes into account the different thematic (racism, right-wing extremism, discrimination) as well as methodological (qualitative research, standardised surveys, data from social media and messaging services) research strands.",
      "http://purl.org/dc/terms/isPartOf": {
        "@id": "https://bioregistry.io/metaregistry/bioregistry"
      },
      "http://www.w3.org/2000/01/rdf-schema#label": {
