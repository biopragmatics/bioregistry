    {
      "@id": "https://bioregistry.io/registry/icpd.project",
      "@type": "https://bioregistry.io/schema/#0000001",
      "http://purl.org/dc/terms/contributor": {
        "@id": "https://orcid.org/0000-0003-2136-4519"
      },
      "http://purl.org/dc/terms/description": "This resource is about projects in the Indian Crop Phenome Database (ICPD). The ICPD is a domain of the Indian Biological Data Center (IBDC), Regional Centre for Biotechnology, Faridabad, developed for the digitization of crop phenome data. Being the global agricultural powerhouse, the bulk of biological data generated in India is associated with agricultural trials. Ironically most of the trial data has been inaccessible to other researchers, and remains unpublished, and is lost as time passes. Therefore, ICPD would act as single-stop user-friendly platform for freely archiving, organizing, analyzing, and sharing the multi-crop phenome data following FAIR (Findable, Accessible, Interoperable and Re-usable) data principles. [from homepage]",
      "http://purl.org/dc/terms/isPartOf": {
        "@id": "https://bioregistry.io/metaregistry/bioregistry"
