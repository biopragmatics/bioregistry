    {
      "@id": "https://bioregistry.io/registry/jecfa",
      "@type": "https://bioregistry.io/schema/#0000001",
      "http://purl.org/dc/terms/contributor": {
        "@id": "https://orcid.org/0009-0009-5240-7463"
      },
      "http://purl.org/dc/terms/description": "JECFA provides identifiers for flavors, food additives, contaminants, toxicants, and veterinary drugs. Each entry includes chemical details, acceptable or tolerable intake limits, and links to related reports and monographs.",
      "http://purl.org/dc/terms/isPartOf": {
