    {
      "@id": "https://bioregistry.io/registry/civic.gid",
      "@type": "https://bioregistry.io/schema/#0000001",
      "http://purl.org/dc/terms/description": "A CIViC Gene Summary is created to provide a high-level overview of clinical relevance of cancer variants for the gene. Gene Summaries in CIViC focus on emphasizing the clinical relevance from a molecular perspective rather than describing the biological function of the gene unless necessary to contextualize its clinical relevance in cancer. Gene Summaries include relevant cancer subtypes, specific treatments for the gene’s associated variants, pathway interactions, functional alterations caused by the variants in the gene, and normal/abnormal functions of the gene with associated roles in oncogenesis",
      "http://purl.org/dc/terms/isPartOf": {
        "@id": "https://bioregistry.io/metaregistry/bioregistry"
      },
