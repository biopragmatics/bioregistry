      },
      "https://bioregistry.io/schema/#0000005": "1",
      "https://bioregistry.io/schema/#0000006": "https://athena.ohdsi.org/search-terms/terms/$1",
      "https://bioregistry.io/schema/#0000008": "^\\d+$",
      "https://bioregistry.io/schema/#0000012": false,
