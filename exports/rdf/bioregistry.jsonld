    {
      "@id": "https://bioregistry.io/registry/odamexplorer",
      "@type": "https://bioregistry.io/schema/#0000001",
      "http://purl.org/dc/terms/description": "ODAM (Open Data for Access and Mining) is an Experimental data table management software (EDTMS) to make research data accessible and available for reuse with minimal effort on the part of the data provider. Designed to manage experimental data tables in an easy way for users, ODAM provides a model for structuring both data and metadata that facilitates data handling and analysis. It also encourages data dissemination according to FAIR principles by making the data interoperable and reusable by both humans and machines.\n\nODAM allows datasets to be explored and then extracted in whole or in part as needed.\n\nFor more information/explanation, see ODAM User's Guide : https://inrae.github.io/ODAM/",
      "http://purl.org/dc/terms/isPartOf": {
        "@id": "https://bioregistry.io/metaregistry/bioregistry"
      },
