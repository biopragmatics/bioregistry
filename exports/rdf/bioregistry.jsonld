        },
        {
          "@id": "https://biodivportal.gfbio.org/ontologies/SUMSO"
        }
      ],
      "http://www.w3.org/ns/dcat#keyword": {
        "@value": "ontology"
      },
      "http://xmlns.com/foaf/0.1/homepage": {
        "@id": "https://www.w3id.org/sumso/repo"
      },
      "https://bioregistry.io/schema/#0000005": "0000015",
